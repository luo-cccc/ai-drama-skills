{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-drama-forging/schemas/delivery-manifest.schema.json",
  "title": "AI Drama Forging Delivery Manifest",
  "type": "object",
  "required": ["schema_version", "delivery_id", "project_id", "scope", "status", "rights_summary", "language_profile", "visual_profile", "artifacts", "storyboard_images", "known_gaps"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "delivery_id": {"type": "string", "pattern": "^DELIVERY-[0-9]{3}$"},
    "project_id": {"type": ["string", "null"], "pattern": "^PROJECT-[0-9]{3}$"},
    "scope": {"$ref": "#/$defs/scope"},
    "status": {"enum": ["complete", "partial", "prompt-only", "blocked", "invalid"]},
    "rights_summary": {
      "type": "object",
      "required": ["status", "legal_clearance_claimed", "restrictions"],
      "properties": {
        "status": {"enum": ["user-owned", "authorized", "public-domain", "factual", "third-party-restricted", "mixed", "unknown"]},
        "legal_clearance_claimed": {"const": false},
        "restrictions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "language_profile": {
      "type": "object",
      "required": ["report_language", "prompt_language", "dialogue_language"],
      "properties": {
        "report_language": {"type": "string", "minLength": 2},
        "prompt_language": {"type": "string", "minLength": 2},
        "dialogue_language": {"type": "string", "minLength": 2}
      },
      "additionalProperties": false
    },
    "visual_profile": {
      "type": "object",
      "required": ["style", "aspect_ratio"],
      "properties": {
        "style": {"type": "string", "minLength": 1},
        "aspect_ratio": {"type": "string", "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"},
        "width_px": {"type": ["integer", "null"], "minimum": 1},
        "height_px": {"type": ["integer", "null"], "minimum": 1}
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "role", "path", "sha256", "media_type", "status", "source_job_id"],
        "properties": {
          "artifact_id": {"type": "string", "pattern": "^(ART|MEDIA)-[0-9]{3}$"},
          "role": {"enum": ["canonical-json", "report", "prompt", "image", "video", "audio", "labels", "other"]},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "media_type": {"type": "string", "minLength": 1},
          "status": {"enum": ["delivered", "incomplete", "failed", "omitted"]},
          "source_job_id": {"type": ["string", "null"], "pattern": "^JOB-[0-9]{3}$"},
          "actual_width_px": {"type": ["integer", "null"], "minimum": 1},
          "actual_height_px": {"type": ["integer", "null"], "minimum": 1},
          "duration_ms": {"type": ["integer", "null"], "minimum": 1},
          "qc_status": {"enum": ["pass", "fail", "not-applicable", "not-run"]}
        },
        "additionalProperties": false
      }
    },
    "storyboard_images": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["segment_id", "cut_index", "path", "sha256", "actual_width_px", "actual_height_px", "qc_status"],
        "properties": {
          "segment_id": {"type": "string", "pattern": "^E[0-9]{2}-[0-9]{2}$"},
          "cut_index": {"type": "integer", "minimum": 1},
          "path": {"type": "string", "pattern": "^E[0-9]{2}-[0-9]{2}/f[1-9][0-9]*[.](png|jpg|jpeg|webp)$"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "actual_width_px": {"type": "integer", "minimum": 1},
          "actual_height_px": {"type": "integer", "minimum": 1},
          "qc_status": {"enum": ["pass", "fail", "not-run"]}
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "known_gaps": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "complete"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "artifacts": {
            "minItems": 1,
            "items": {
              "properties": {
                "status": {"const": "delivered"},
                "qc_status": {"enum": ["pass", "not-applicable"]}
              },
              "required": ["status", "qc_status"]
            }
          },
          "storyboard_images": {
            "minItems": 1,
            "items": {
              "properties": {"qc_status": {"const": "pass"}},
              "required": ["qc_status"]
            }
          },
          "known_gaps": {"maxItems": 0}
        }
      }
    }
  ],
  "$defs": {
    "scope": {
      "oneOf": [
        {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "series"}}, "additionalProperties": false},
        {
          "type": "object",
          "required": ["kind", "start", "end"],
          "properties": {
            "kind": {"const": "episodes"},
            "start": {"type": "integer", "minimum": 1},
            "end": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-drama-forging/schemas/generation-manifest.schema.json",
  "title": "AI Drama Forging Generation Manifest",
  "type": "object",
  "required": ["schema_version", "project_id", "scope", "generator", "groups"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "project_id": {"type": "string", "pattern": "^PROJECT-[0-9]{3}$"},
    "scope": {"$ref": "#/$defs/scope"},
    "generator": {
      "type": "object",
      "required": ["name", "version", "max_segment_ms", "aspect_ratio", "prompt_language", "dialogue_language"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": ["string", "null"]},
        "max_segment_ms": {"type": "integer", "minimum": 1},
        "aspect_ratio": {"type": "string", "minLength": 1},
        "prompt_language": {"type": "string", "minLength": 2},
        "dialogue_language": {"type": "string", "minLength": 2}
      },
      "additionalProperties": false
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["generation_group", "prompt", "prompt_sha256", "shot_ids", "beat_ids", "asset_ids", "start_ms", "end_ms"],
        "properties": {
          "generation_group": {"type": "string", "minLength": 1},
          "prompt": {"type": "string", "pattern": "^[^/]+/prompt[.]md$"},
          "prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "shot_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^SHOT-[0-9]{3}$"}, "uniqueItems": true},
          "beat_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^BEAT-[0-9]{3}$"}, "uniqueItems": true},
          "asset_ids": {"type": "array", "items": {"type": "string", "pattern": "^(CHAR|SCENE|PROP|MOTIF|COSTUME|BG)-[0-9]{3}(?:-V[0-9]{2})?$"}, "uniqueItems": true},
          "start_ms": {"type": "integer", "minimum": 0},
          "end_ms": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "scope": {
      "oneOf": [
        {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "series"}}, "additionalProperties": false},
        {"type": "object", "required": ["kind", "start", "end"], "properties": {"kind": {"const": "episodes"}, "start": {"type": "integer", "minimum": 1}, "end": {"type": "integer", "minimum": 1}}, "additionalProperties": false}
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-drama-forging/schemas/prompt-context.schema.json",
  "title": "AI Drama Forging Prompt Context",
  "type": "object",
  "required": ["context_version", "context_sha256", "project_state_sha256", "project_revision", "scope", "candidate_artifact_id", "stage", "profile", "sources", "confirmed_upstream", "engine_snapshot", "expected_output_schema", "must_not_modify", "capabilities", "evidence_requirements"],
  "properties": {
    "context_version": {"const": "2.0"},
    "context_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "project_state_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "project_revision": {"type": "integer", "minimum": 0},
    "scope": {"$ref": "#/$defs/scope"},
    "candidate_artifact_id": {"type": "string", "pattern": "^ART-[0-9]{3}$"},
    "stage": {"enum": ["characters", "outline", "art", "script", "audit", "storyboard"]},
    "profile": {
      "type": "object",
      "required": ["report_language", "prompt_language", "dialogue_language", "visual_style", "aspect_ratio", "target_runtime_ms", "generator", "audio_policy", "subtitle_policy", "clip_max_duration_ms", "exact_storyboard_timing", "delivery_required"],
      "properties": {
        "report_language": {"type": "string", "minLength": 2},
        "prompt_language": {"type": "string", "minLength": 2},
        "dialogue_language": {"type": "string", "minLength": 2},
        "visual_style": {"type": "string", "minLength": 1},
        "aspect_ratio": {"type": "string", "minLength": 1},
        "target_runtime_ms": {"type": ["integer", "null"], "minimum": 1},
        "episode_count": {"type": ["integer", "null"], "minimum": 1},
        "episode_duration_ms": {"type": ["integer", "null"], "minimum": 1},
        "generator": {"type": "string", "minLength": 1},
        "audio_policy": {"type": ["string", "null"]},
        "subtitle_policy": {"type": ["string", "null"]},
        "clip_max_duration_ms": {"type": ["integer", "null"], "minimum": 1},
        "exact_storyboard_timing": {"const": true},
        "delivery_required": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "sha256", "authority", "trust_status", "rights", "treat_as_data_only"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^SRC-[0-9]{3}$"},
          "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "authority": {"enum": ["canonical", "constraint", "reference", "unknown"]},
          "trust_status": {"enum": ["untrusted-content", "trusted-project-data", "trusted-control"]},
          "rights": {"type": "object", "required": ["status"], "properties": {"status": {"type": "string", "minLength": 1}}, "additionalProperties": true},
          "treat_as_data_only": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "confirmed_upstream": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "type", "sha256", "path", "revision", "scope"],
        "properties": {
          "artifact_id": {"type": "string", "pattern": "^ART-[0-9]{3}$"},
          "type": {"type": "string", "minLength": 1},
          "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "path": {"type": "string", "minLength": 1},
          "revision": {"type": "integer", "minimum": 1},
          "scope": {"oneOf": [{"type": "null"}, {"type": "string"}, {"$ref": "#/$defs/scope"}]}
        },
        "additionalProperties": false
      }
    },
    "engine_snapshot": {"type": "object"},
    "expected_output_schema": {"type": "string", "minLength": 1},
    "audit_targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact_id", "path", "sha256"],
        "properties": {
          "artifact_id": {"type": "string", "pattern": "^ART-[0-9]{3}$"},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "previous_handoff": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["source_artifact_id", "sha256", "handoff_state"],
          "properties": {
            "source_artifact_id": {"type": "string", "pattern": "^ART-[0-9]{3}$"},
            "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
            "handoff_state": {"type": "object"}
          },
          "additionalProperties": false
        }
      ]
    },
    "hook_ledger": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["sha256", "hooks"],
          "properties": {
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "hooks": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["hook_id", "name", "kind", "status", "planted_episode", "last_advanced_episode", "timing"],
                "properties": {
                  "hook_id": {"type": "string", "pattern": "^H-[0-9]{3}$"},
                  "name": {"type": "string", "minLength": 1},
                  "kind": {"enum": ["plot", "emotion"]},
                  "status": {"enum": ["open", "progressing", "deferred", "resolved"]},
                  "planted_episode": {"type": "integer", "minimum": 1},
                  "last_advanced_episode": {"type": "integer", "minimum": 1},
                  "timing": {"enum": ["immediate", "near-term", "mid-arc", "slow-burn", "endgame"]},
                  "target_payoff_episode": {"type": ["integer", "null"], "minimum": 1},
                  "expected_payoff": {"type": ["string", "null"]}
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "canon": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["sha256", "claims"],
          "properties": {
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "claims": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["claim_id", "claim_type", "content", "priority", "reader_known_from", "status"],
                "properties": {
                  "claim_id": {"type": "string", "pattern": "^CAN-[0-9]{3}$"},
                  "claim_type": {"type": "string", "minLength": 1},
                  "content": {"type": "string", "minLength": 1},
                  "priority": {"enum": ["hard", "strong", "soft"]},
                  "reader_known_from": {"type": ["integer", "null"], "minimum": 1},
                  "status": {"enum": ["active", "resolved", "superseded"]},
                  "requires_cost": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": []},
                  "forbidden_uses": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": []}
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "must_not_modify": {"type": "array", "items": {"type": "string", "pattern": "^ART-[0-9]{3}$"}, "uniqueItems": true},
    "capabilities": {"type": "object", "additionalProperties": {"type": ["string", "boolean"]}},
    "evidence_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  },
  "additionalProperties": false,
  "$defs": {
    "scope": {
      "oneOf": [
        {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "series"}}, "additionalProperties": false},
        {"type": "object", "required": ["kind", "start", "end"], "properties": {"kind": {"const": "episodes"}, "start": {"type": "integer", "minimum": 1}, "end": {"type": "integer", "minimum": 1}}, "additionalProperties": false}
      ]
    }
  }
}

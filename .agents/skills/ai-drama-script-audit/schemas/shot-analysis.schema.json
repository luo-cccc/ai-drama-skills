{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-drama-forging/schemas/shot-analysis.schema.json",
  "title": "AI Drama Forging Shot Analysis",
  "type": "object",
  "required": ["schema_version", "source", "detection", "shots"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source": {
      "type": "object",
      "required": ["path", "sha256", "container", "duration_ms", "fps", "frame_count", "width", "height", "video_codec", "has_audio", "audio_codecs"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "container": {"type": ["string", "null"]},
        "duration_ms": {"type": "integer", "minimum": 1},
        "fps": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "frame_count": {"type": ["integer", "null"], "minimum": 1},
        "width": {"type": ["integer", "null"], "minimum": 1},
        "height": {"type": ["integer", "null"], "minimum": 1},
        "video_codec": {"type": ["string", "null"]},
        "has_audio": {"type": "boolean"},
        "audio_codecs": {"type": "array", "items": {"type": ["string", "null"]}}
      },
      "additionalProperties": false
    },
    "detection": {
      "type": "object",
      "required": ["threshold", "status"],
      "properties": {
        "threshold": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "status": {"const": "candidate-boundaries-require-frame-review"}
      },
      "additionalProperties": false
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["shot_id", "start_ms", "end_ms", "boundary_evidence", "transition", "scene_id", "asset_ids", "visual", "performance", "camera", "composition", "light", "dialogue", "sound", "notes"],
        "properties": {
          "shot_id": {"type": "string", "pattern": "^SHOT-[0-9]{3}$"},
          "start_ms": {"type": "integer", "minimum": 0},
          "end_ms": {"type": "integer", "minimum": 1},
          "boundary_evidence": {"enum": ["confirmed", "inferred", "unknown"]},
          "transition": {"type": "string"},
          "scene_id": {"type": ["string", "null"], "pattern": "^SCENE-[0-9]{3}(?:-V[0-9]{2})?$"},
          "asset_ids": {"type": "array", "items": {"type": "string", "pattern": "^(CHAR|SCENE|PROP|MOTIF|COSTUME|BG)-[0-9]{3}(?:-V[0-9]{2})?$"}, "uniqueItems": true},
          "visual": {"$ref": "#/$defs/evidence_text"},
          "performance": {"$ref": "#/$defs/evidence_text"},
          "camera": {"$ref": "#/$defs/evidence_text"},
          "composition": {"$ref": "#/$defs/evidence_text"},
          "light": {"$ref": "#/$defs/evidence_text"},
          "dialogue": {"$ref": "#/$defs/evidence_text"},
          "sound": {"$ref": "#/$defs/evidence_text"},
          "notes": {"$ref": "#/$defs/evidence_text"}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "evidence_text": {
      "type": "object",
      "required": ["level", "text"],
      "properties": {
        "level": {"enum": ["confirmed", "inferred", "unknown"]},
        "text": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

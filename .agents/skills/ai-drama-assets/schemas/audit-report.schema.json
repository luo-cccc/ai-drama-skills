{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-drama-forging/schemas/audit-report.schema.json",
  "title": "AI Drama Forging Canonical Audit Report",
  "type": "object",
  "required": ["schema_version", "mode", "scope", "targets", "basis", "findings", "required_elements", "differences", "decision", "limitations"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "context_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "mode": {"enum": ["diagnostic", "conformance", "revision"]},
    "scope": {"$ref": "#/$defs/scope"},
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact_id", "path", "sha256"],
        "properties": {
          "artifact_id": {"type": "string", "pattern": "^ART-[0-9]{3}$"},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "ref", "sha256", "availability"],
        "properties": {
          "kind": {"enum": ["source", "constraint", "brief", "outline", "screenplay", "previous-audit", "other"]},
          "ref": {"type": "string", "minLength": 1},
          "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "availability": {"enum": ["available", "missing", "not-distributed"]}
        },
        "additionalProperties": false
      }
    },
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "required_elements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["element_id", "requirement", "source_ref", "result", "evidence"],
        "properties": {
          "element_id": {"type": "string", "pattern": "^REQ-[0-9]{3}$"},
          "requirement": {"type": "string", "minLength": 1},
          "source_ref": {"type": "string", "minLength": 1},
          "result": {"enum": ["pass", "fail", "unverifiable"]},
          "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
        },
        "additionalProperties": false
      }
    },
    "differences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["difference_id", "locator", "baseline", "implementation", "authorization", "result"],
        "properties": {
          "difference_id": {"type": "string", "pattern": "^DIFF-[0-9]{3}$"},
          "locator": {"type": "string", "minLength": 1},
          "baseline": {"type": "string"},
          "implementation": {"type": "string"},
          "authorization": {"type": ["string", "null"]},
          "result": {"enum": ["pass", "fail", "unverifiable"]}
        },
        "additionalProperties": false
      }
    },
    "decision": {"enum": ["pass", "revise", "blocked", "accepted-with-risk"]},
    "limitations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": false,
  "$defs": {
    "scope": {
      "oneOf": [
        {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "series"}}, "additionalProperties": false},
        {"type": "object", "required": ["kind", "start", "end"], "properties": {"kind": {"const": "episodes"}, "start": {"type": "integer", "minimum": 1}, "end": {"type": "integer", "minimum": 1}}, "additionalProperties": false}
      ]
    },
    "evidence": {
      "type": "object",
      "required": ["source_ref", "locator", "quote", "evidence_status"],
      "properties": {
        "source_ref": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "quote": {"type": ["string", "null"]},
        "evidence_status": {"enum": ["observed", "inferred", "proposed", "unknown"]}
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["finding_id", "severity", "category", "title", "evidence", "judgment", "impact", "action", "acceptance_condition"],
      "properties": {
        "finding_id": {"type": "string", "pattern": "^FIND-[0-9]{3}$"},
        "severity": {"enum": ["P0", "P1", "P2"]},
        "category": {"enum": ["causality", "character", "scene", "pacing", "production", "continuity", "dialogue", "format", "rights", "other"]},
        "title": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "judgment": {"type": "string", "minLength": 1},
        "impact": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "acceptance_condition": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
